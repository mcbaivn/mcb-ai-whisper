# Supabase (required - Google OAuth only)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Supabase redirect for desktop OAuth is handled via mcb-whisper://auth/callback (no env needed)

# Optional: cloud transcription
VITE_OPENWHISPR_API_URL=

OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
LANGUAGE=
UI_LANGUAGE=en
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
TINFOIL_API_KEY=
MISTRAL_API_KEY=
OPENWHISPR_LOG_LEVEL=debug
